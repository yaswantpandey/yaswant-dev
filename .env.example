# Directory Structure on Hostinger:
# /home/username/ (or your account root)
# ├── .env               <-- COPY THIS FILE HERE
# └── public_html/       <-- Website files
#     ├── config.php
#     ├── index.php
#     └── ...
# ==============================================================================

