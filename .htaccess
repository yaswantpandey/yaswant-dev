# ─── HTTPS Redirect (Excluded for local dev) ──────────────────────────────────
RewriteEngine On
ErrorDocument 404 /404.php
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ─── WWW → non-WWW ────────────────────────────────────────────────────────────
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://yaswant.co.in%{REQUEST_URI} [L,R=301]

# ─── Subdomain Routing (shared public_html, no code duplication) ───────────────
# All subdomains share the same /public_html/ directory on Hostinger.
# Each subdomain root (/) is transparently served by its matching PHP file.
# Deep paths on subdomains (e.g., resume.yaswant.co.in/api/...) pass through normally.

# resume.yaswant.co.in → resume.php
RewriteCond %{HTTP_HOST} ^resume\.yaswant\.co\.in$ [NC]
RewriteCond %{REQUEST_URI} ^/?$
RewriteRule ^ /resume.php [L]

# resource.yaswant.co.in → resources.php
RewriteCond %{HTTP_HOST} ^resource\.yaswant\.co\.in$ [NC]
RewriteCond %{REQUEST_URI} ^/?$
RewriteRule ^ /resources.php [L]

# course.yaswant.co.in → courses.php (root)
RewriteCond %{HTTP_HOST} ^course\.yaswant\.co\.in$ [NC]
RewriteCond %{REQUEST_URI} ^/?$
RewriteRule ^ /courses.php [L]

# course.yaswant.co.in/data-analyst → /course/data-analyst.php (clean slug routing)
RewriteCond %{HTTP_HOST} ^course\.yaswant\.co\.in$ [NC]
RewriteCond %{REQUEST_URI} !^/?$
RewriteCond /public_html/course%{REQUEST_URI}.php -f
RewriteRule ^([a-zA-Z0-9_-]+)/?$ /course/$1.php [L]

# tools.yaswant.co.in → tools.php
RewriteCond %{HTTP_HOST} ^tools\.yaswant\.co\.in$ [NC]
RewriteCond %{REQUEST_URI} ^/?$
RewriteRule ^ /tools.php [L]

# blog.yaswant.co.in → blog.php
RewriteCond %{HTTP_HOST} ^blog\.yaswant\.co\.in$ [NC]
RewriteCond %{REQUEST_URI} ^/?$
RewriteRule ^ /blog.php [L]

# internship.yaswant.co.in → internships.php
RewriteCond %{HTTP_HOST} ^internship\.yaswant\.co\.in$ [NC]
RewriteCond %{REQUEST_URI} ^/?$
RewriteRule ^ /internships.php [L]

# ─── Clean Extensionless URLs (e.g. /tools/json-formatter -> /tools/json-formatter.php) ──
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# ─── Gzip Compression ─────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml font/woff2
</IfModule>

# ─── Browser Caching ──────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 1 hour"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType application/json       "access plus 1 day"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# ─── Cache-Control Headers ────────────────────────────────────────────────────
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|png|jpg|jpeg|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(admin|admin_login|admin_logout)\.php$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, private"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "^(index|courses|resources|internships|blog|tools|resume|search|dashboard)\.php$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  # ─── Security Headers (boost Lighthouse best-practices score) ───────────────
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ─── ETags ────────────────────────────────────────────────────────────────────
FileETag None
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>

# ─── Protect sensitive files ──────────────────────────────────────────────────
<FilesMatch "^(\.env|composer\.json|composer\.lock|package\.json)$">
  Require all denied
</FilesMatch>

# ─── Block access to data directory ───────────────────────────────────────────
RedirectMatch 403 ^/data/
